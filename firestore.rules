rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Users ----
    // Patients need to read doctor profiles for search/details.
    // Guests can browse verified doctor profiles only.
    // Writes are limited to own doc, admin, or rating aggregation.
    match /users/{userId} {
      allow read: if isSignedIn() ||
        (resource.data.role == 'doctor' && resource.data.isVerified == true);

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if (isSelf(userId) &&
          // Doctors cannot set their own isVerified; only admin can verify
          !(resource.data.role == 'doctor' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVerified']) &&
            request.resource.data.isVerified == true &&
            resource.data.isVerified == false)) ||
        isAdmin() ||
        // Allow any signed-in user to update only rating aggregation
        // on a doctor doc (used by feedback_helper after review).
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['rating', 'reviewCount']) &&
         resource.data.role == 'doctor');

      allow delete: if isSelf(userId) || isAdmin();

      // Doctor availability slots: users/{uid}/availability/{date}
      match /availability/{dateKey} {
        // Guests may preview a verified doctor's open slots before signing in
        // to book.
        allow read: if isSignedIn() ||
          (get(/databases/$(database)/documents/users/$(userId)).data.role == 'doctor' &&
           get(/databases/$(database)/documents/users/$(userId)).data.isVerified == true);
        allow write: if isSelf(userId) || isAdmin();
      }
    }

    // ---- Appointments ----
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.patient_id == request.auth.uid ||
        resource.data.doctor_id == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.patient_id == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.patient_id == request.auth.uid ||
        resource.data.doctor_id == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.patient_id == request.auth.uid ||
        resource.data.doctor_id == request.auth.uid ||
        isAdmin()
      );
    }

    // ---- Reviews ----
    // Public: doctor profiles show reviews to guests and patients. Kept out of
    // the appointments collection so patients never read each other's visits.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.patient_id == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.patient_id == request.auth.uid ||
        resource.data.doctor_id == request.auth.uid ||
        isAdmin()
      );
    }

    // ---- Booked slots (double-booking lock) ----
    match /booked_slots/{slotId} {
      // Public: guests browse a doctor's open slots before signing in.
      // The doc only holds slot time + uids, no patient details.
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.bookedBy == request.auth.uid &&
        request.resource.data.doctorId is string;
      allow update: if false; // never update, only create/delete
      allow delete: if isSignedIn() && (
        resource.data.bookedBy == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    // ---- Chats + Messages ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if isSignedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
